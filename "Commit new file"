body {
    font-family: Arial, sans-serif;
    background: #f7f8fa;
    margin: 0;
    padding: 0;
}
header {
    background: #3a3a3a;
    color: #fff;
    padding: 20px 0;
    text-align: center;
}
nav a {
    color: #c7e1ff;
    margin: 0 10px;
    text-decoration: none;
}
nav a:hover {
    text-decoration: underline;
}
main {
    max-width: 700px;
    margin: 30px auto 40px auto;
    background: #fff;
    padding: 30px;
    box-shadow: 0 4px 16px #00000011;
    border-radius: 8px;
}
footer {
    background: #eeeeee;
    text-align: center;
    padding: 10px 0;
    color: #555;
    font-size: 1em;
}
h1, h2, h3 {
    margin-top: 0;
}
ul {
